<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/form.css">
</head>
<body>
    <%- include('./includes/header') %>

    <main>
        <div class="form-container">
            <div class="form-card">
                <h2 class="form-title">➕ Agregar Nueva Tarea</h2>
                
                <form action="<%= actionUrl %>" method="POST">
                    <div class="form-group">
                        <label for="title" class="form-label">📌 Título de la Tarea</label>
                        <input 
                            type="text" 
                            id="title" 
                            name="title" 
                            class="form-input" 
                            placeholder="Ej: Comprar víveres, Estudiar para el examen..."
                            required
                        >
                    </div>
                    
                    <div class="form-group">
                        <label for="description" class="form-label">📝 Descripción</label>
                        <textarea 
                            id="description" 
                            name="description" 
                            class="form-textarea" 
                            placeholder="Describe los detalles de tu tarea..."
                        ></textarea>
                    </div>
                    
                    <div class="form-actions">
                        <a href="/tasks/read-tasks" class="btn btn-secondary">← Volver a Tareas</a>
                        <button type="submit" class="btn btn-primary">
                            ✅ Guardar Tarea
                        </button>
                    </div>
                </form>
                
                <div class="form-help">
                    <p>💡 <strong>Tip:</strong> Sé específico con el título y agrega detalles importantes en la descripción.</p>
                </div>
            </div>
        </div>
    </main>

    <%- include('./includes/footer') %>
</body>
</html>